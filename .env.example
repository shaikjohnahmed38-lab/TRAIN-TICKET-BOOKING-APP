# GEMINI_API_KEY: Optional for AI features if enabled.
GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted.
APP_URL=

# DATABASE_PATH: Optional SQLite file path for persistent production storage (defaults to ./data/rail_demo.db).
DATABASE_PATH=

# ADMIN_PASSCODE: Optional shared passcode to sign into or claim Admin Portal privileges.
ADMIN_PASSCODE=

# SMTP Email Configuration (Optional - enables real verification, password reset & ticket emails)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Twilio SMS Configuration (Optional - enables real mobile OTP delivery)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Razorpay Payment Gateway Configuration (Optional - enables real payment orders & webhook verification)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Official Railway API Configuration (Optional - enables live train running status integration)
RAILWAY_API_BASE_URL=
RAILWAY_API_KEY=
